# -*- mode: ruby -*-
source 'https://rubygems.org'

# The styleguide app runs on exactly the same gems as `rake test` does from the
# repository root, so it reuses that Gemfile instead of restating it. Keeping
# two lists in sync by hand is how this app drifted out of working order before.
eval_gemfile File.expand_path('../../Gemfile', __dir__)

# Only needed here: `rake test` drives the app in-process, `rails s` needs a
# web server.
gem 'puma'
